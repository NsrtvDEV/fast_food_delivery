PROJECT_NAME=fast_food_delivery
DEBUG=1

DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_NAME=

SECRET_KEY=

EMAIL_PASSWORD=

# If set, email is sent via the Resend HTTP API instead of SMTP. Needed on
# hosts that block outbound SMTP ports (e.g. Render's free tier) - EMAIL_*/
# SMTP_* above are only used as a fallback when this is unset. Get a key at
# resend.com; sending to arbitrary recipients (not just your own account
# email) requires verifying a domain there first.
RESEND_API_KEY=

# If set, uploaded product photos go to S3-compatible object storage
# instead of local disk. Needed on hosts with an ephemeral filesystem
# (Render's free tier wipes local files on every restart) - photos
# otherwise vanish the next time the service restarts.
#
# For Supabase Storage: create a bucket (make it Public), then Project
# Settings -> Data API -> get the S3 Connection details.
#   S3_ENDPOINT_URL = https://<project-ref>.supabase.co/storage/v1/s3
#   S3_REGION        = your project's region (shown alongside the endpoint)
#   S3_PUBLIC_URL    = https://<project-ref>.supabase.co/storage/v1/object/public/<bucket>
#   S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY = from a new S3 access key
#     (Project Settings -> Data API -> S3 Access Keys -> New access key)
#
# For Cloudflare R2 instead: S3_ENDPOINT_URL is
# https://<account_id>.r2.cloudflarestorage.com, S3_REGION is "auto",
# S3_PUBLIC_URL is the bucket's r2.dev URL (or a custom domain).
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION=auto
S3_PUBLIC_URL=

# Comma-separated list of origins allowed to call this API from a browser.
# Include your deployed frontend's URL here in production
# (e.g. https://your-app.vercel.app), in addition to the local dev origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# One-time secret required in the registration request to grant the first
# registered user admin rights. Leave unset to disable self-service admin
# bootstrap entirely; promote the account manually via /admin in that case.
SETUP_TOKEN=

# Token from @BotFather for the phone-login Telegram bot, and a random secret
# you choose yourself (any long random string) used to verify that webhook
# calls to /telegram/webhook genuinely come from Telegram. After deploying,
# register the webhook once via:
#   https://api.telegram.org/bot<TELEGRAM_TOKEN>/setWebhook?url=<BASE_URL>/telegram/webhook&secret_token=<TELEGRAM_WEBHOOK_SECRET>
TELEGRAM_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
