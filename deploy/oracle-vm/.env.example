# Copy to .env in this same folder and fill in real values before running
# `docker compose up -d`.

# Any long random string - protects Redis since it's reachable from the
# public internet (Render's API needs to reach it).
REDIS_PASSWORD=

# Must match the values Render generated for foodify-api, so this worker
# writes to the exact same database. Get these from the Render dashboard:
# foodify-api service -> Environment tab (DB_* vars) - or foodify-db's
# "External Connection" details, since this VM reaches it over the public
# internet rather than Render's private network.
PROJECT_NAME=fast_food_delivery
DEBUG=0
SECRET_KEY=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_NAME=

# Same Gmail app password as the main .env - this worker is what actually
# sends the emails.
EMAIL_PASSWORD=
